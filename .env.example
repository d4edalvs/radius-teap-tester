# Copy to .env and edit. Every value here has a safe default, so an empty
# .env is the same as no .env.

# Where the web interface listens on the host.
# 127.0.0.1 keeps it to this machine; 0.0.0.0 exposes it on every interface;
# a single address exposes it on just that one.
TEAP_GUI_BIND=127.0.0.1
TEAP_GUI_PORT=8010

# Change-of-Authorization listener. Only used if you uncomment the udp port
# mapping in docker-compose.yml. It must be reachable from the policy server.
TEAP_COA_BIND=0.0.0.0
TEAP_COA_PORT=3799

# Encrypts stored shared secrets and private keys. Left empty, one is
# generated into the data volume on first run. Set it to keep stored secrets
# readable if the volume is ever recreated.
TEAP_GUI_KEY=

# Behind a reverse proxy that rewrites the Host header, the public origin
# (comma-separated if several). Form posts from any other origin are refused.
TEAP_GUI_ALLOWED_ORIGINS=

TZ=UTC
